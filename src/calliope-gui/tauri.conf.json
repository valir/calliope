{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "calliope-gui",
  "identifier": "app.calliope.gui",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      { "label": "main", "title": "calliope", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 640, "center": true, "visible": false }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
